{
  "name": "openvibe-example-vibes-pay",
  "version": "0.1.0",
  "private": true,
  "description": "Vibes Pay: a tiny sticker shop that creates a charge with openvibe-sdk/vibes, opens the pay sheet with vibes-pay.js, and marks the order paid from a signed webhook.",
  "license": "MIT",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node test/smoke.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "openvibe-sdk": "https://git.openvibe.codes/api/v1/repos/openvibers/openvibe.sdk/archive/v0.174.0.tar.gz",
    "openvibe-shared": "https://git.openvibe.codes/api/v1/repos/openvibers/openvibe.shared/archive/v4.285.0.tar.gz"
  }
}
