# The app's token (capability billing.vibes.charge). Keep it on the server; never put it in the page.
OV_APP_TOKEN=

# The app's webhook secret from its page in OpenVibe.Services. Keep it on the server.
OV_VIBES_WEBHOOK_SECRET=

# Billing's origin and this shop's public origin (the return_url is built from it).
OV_BILLING_URL=https://billing.openvibe.network
OV_PUBLIC_URL=http://localhost:8099

# The one item in this tiny shop.
OV_PORT=8099
OV_ITEM_NAME=Sticker pack: Neon cats
OV_PRICE_VIBES=50
