# A PUBLIC developer app (type "public": no client secret) in your OpenVibe project.
# Register the redirect URI below on the app exactly as written.
OV_NETWORK_URL=https://openvibe.network
OV_CLIENT_ID=
# Sign-in asks for capabilities of ONE audience; the app needs an approved grant for each.
OV_AUDIENCE=openvibe.media
OV_SCOPE=media.object.read
OV_REDIRECT_URI=http://localhost:3001/callback
# Defaults to the redirect URI's port.
OV_PORT=3001
