# A CONFIDENTIAL developer app holding tools.job.create and tools.job.read (audience openvibe.tools).
OV_NETWORK_URL=https://openvibe.network
OV_CLIENT_ID=
OV_CLIENT_SECRET=
# The Tools satellite that runs the job type (img.process runs on img.openvibe.tools).
OV_TOOLS_JOBS_URL=https://img.openvibe.tools
OV_JOB_TYPE=img.process
OV_JOB_INPUT={"tool":"convert","format":"webp"}
OV_OUT_DIR=./out
OV_JOB_STATE=./.job-state.json
