# server.js: the subscription's signing secret (subscribe.js writes it to .env.webhook).
OV_WEBHOOK_SECRET=
# While rotating: the previous secret, accepted until you remove it.
OV_WEBHOOK_SECRET_PREVIOUS=
OV_WEBHOOK_PATH=/webhooks/openvibe
OV_DB_PATH=./data/webhook-consumer.db
OV_PORT=3003

# subscribe.js: an app holding events.subscription.manage (audience openvibe.events).
OV_NETWORK_URL=https://openvibe.network
OV_CLIENT_ID=
OV_CLIENT_SECRET=
# Optional: an explicit Events origin instead of the one the registry advertises.
OV_EVENTS_URL=
