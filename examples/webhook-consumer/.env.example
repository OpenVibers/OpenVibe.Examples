# server.js: the subscription's signing secret (subscribe.js writes it to .env.webhook).
OV_WEBHOOK_SECRET=
# While rotating: the previous secret, accepted until you remove it.
OV_WEBHOOK_SECRET_PREVIOUS=
OV_WEBHOOK_PATH=/webhooks/openvibe
# PostgreSQL for the inbox and the received_events table; empty: an embedded PGlite in OV_DATA_DIR.
OV_DATABASE_URL=
OV_DATA_DIR=./data/pg
OV_PORT=3003

# subscribe.js: a CONFIDENTIAL sandbox app holding events.app.subscribe (audience openvibe.events).
OV_NETWORK_URL=https://openvibe.network
OV_CLIENT_ID=
OV_CLIENT_SECRET=
# Optional: your project id (prj_...); read from the app token when empty.
OV_PROJECT_ID=
# Optional: an explicit Events origin instead of the one the registry advertises.
OV_EVENTS_URL=
