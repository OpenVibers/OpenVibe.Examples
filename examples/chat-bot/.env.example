# Chat WebSocket (served on openvibe.live until openvibe.chat launches).
OV_CHAT_WS_URL=wss://openvibe.live/ws/chat
# A Live API token (hbt_..., scope "chat") created by a DEDICATED bot account whose name contains "bot".
OV_CHAT_TOKEN=
# Exactly one room: a channel (the streamer's user id) or a stream id.
OV_CHAT_CHANNEL_USER_ID=
OV_CHAT_STREAM_ID=
OV_BOT_PREFIX="[bot] "
OV_BOT_TRIGGER=?
# Who runs the bot (shown by ?about).
OV_BOT_OWNER=
OV_BOT_MIN_INTERVAL_MS=2000
