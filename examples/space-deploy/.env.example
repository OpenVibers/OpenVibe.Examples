# A developer app of the site's project (openvibe.services → project → Apps), added to the Space project as a
# deployer (openvibe.space → project → Members → app:<client id>). In CI these are repository secrets.
OV_CLIENT_ID=
OV_CLIENT_SECRET=
# The site to deploy to: its id (sit_…) is on the site's page in the Space dashboard.
OV_SPACE_SITE=
# Optional:
# OV_DIR=dist               # the built folder; it must have an index.html at its top
# OV_PREVIEW=1              # a preview deploy (pull requests) instead of going live
# OV_NETWORK_URL=https://openvibe.network
# OV_SPACE_URL=https://openvibe.space
