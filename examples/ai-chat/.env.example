# A CONFIDENTIAL developer app holding ai.app.run (audience openvibe.ai; a sandbox app has it by default).
OV_NETWORK_URL=https://openvibe.network
OV_CLIENT_ID=
OV_CLIENT_SECRET=
OV_AI_URL=https://ai.openvibe.services/v1
# Optional: your project's own OpenAI-format provider instead of AI's router (ADR-056).
# OV_PROVIDER_SECRET is the NAME of a project secret granted to ai for that origin, never the key itself.
# OV_PROVIDER_BASE_URL=https://api.openai.com/v1
# OV_PROVIDER_MODEL=gpt-5-mini
# OV_PROVIDER_SECRET=openai-key
