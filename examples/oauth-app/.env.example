# A CONFIDENTIAL developer app with the redirect URI below registered exactly as written.
OV_NETWORK_URL=https://openvibe.network
OV_CLIENT_ID=
OV_CLIENT_SECRET=
# Sign-in asks for capabilities of ONE audience; the app needs an approved grant for each.
OV_AUDIENCE=openvibe.media
OV_SCOPE=media.object.upload media.object.read
OV_REDIRECT_URI=http://localhost:3009/callback
# Defaults to the redirect URI's port.
OV_PORT=3009
