# pull (default): your project's own events as your app. realtime: public first-party events, no credentials.
OV_EVENTS_MODE=pull
# A CONFIDENTIAL sandbox app holding events.app.read (and events.app.publish for publish.js).
OV_NETWORK_URL=https://openvibe.network
OV_CLIENT_ID=
OV_CLIENT_SECRET=
# Optional: your project id (prj_...); read from the app token when empty.
OV_PROJECT_ID=
# Pull: patterns relative to your project (order.*); empty means * = app.<project_key>.*.
# Realtime: required, public first-party topics, e.g. chat.message.created
OV_TOPICS=
# Pull only: public first-party topics to read as well (e.g. live.stream.*)
OV_PLATFORM_TOPICS=
OV_CURSOR_PATH=./data/cursor.json
OV_POLL_MS=5000
# Optional: an explicit Events origin instead of the one the registry advertises.
OV_EVENTS_URL=
