# realtime: SSE, works without credentials for public events. pull: needs events.event.read.
OV_EVENTS_MODE=realtime
OV_TOPICS=chat.message.created
OV_CURSOR_PATH=./data/cursor.json
OV_POLL_MS=5000
OV_NETWORK_URL=https://openvibe.network
# Optional: an explicit Events origin instead of the one the registry advertises.
OV_EVENTS_URL=
# Only for pull mode (or to read non-public events over realtime).
OV_CLIENT_ID=
OV_CLIENT_SECRET=
