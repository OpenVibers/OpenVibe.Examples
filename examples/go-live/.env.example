# A Live API token: openvibe.live → Dashboard → API tokens, scopes "read" and "stream" (the "Stream Controller" preset).
# It can start and end your streams; keep it out of git.
OV_LIVE_TOKEN=
# Optional:
# OV_LIVE_URL=https://openvibe.live
# OV_SLOT_ID=123            # publish to this slot; otherwise one titled OV_TITLE is found or created (streaming method WHIP)
# OV_TITLE=Live from code
# OV_CATEGORY=Science & Technology
# OV_SOURCE=test            # test (pattern + tone), a video file path, or camera:/dev/video0 (Linux)
# OV_SECONDS=60             # 0 runs until Ctrl-C
# OV_FFMPEG=ffmpeg          # FFmpeg 8.0 or later (it has the WHIP muxer)
