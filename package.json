{
  "name": "openvibe-examples",
  "version": "0.2.0",
  "private": true,
  "description": "Executable public integration examples for the OpenVibe platform: SDK, scoped credentials and public APIs only.",
  "license": "MIT",
  "repository": "github:OpenVibers/OpenVibe.Examples",
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "test": "node test/run.js",
    "e2e": "node --env-file-if-exists=.env scripts/e2e.js",
    "new-app": "node --env-file-if-exists=.env scripts/new-sandbox-app.js",
    "developer-path": "node --env-file-if-exists=.env scripts/developer-path.js",
    "developer-path:mock": "node scripts/developer-path-mock.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "openvibe-sdk": "https://codeload.github.com/OpenVibers/OpenVibe.SDK/tar.gz/refs/tags/v0.4.0"
  }
}
